   "cell_type": "code",
   "metadata": {},
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "# Optional imports – they may fail if optional libs are not installed\n",
    "try:\n",
    "    import fitz  # PyMuPDF for PDF handling\n",
    "except ImportError:\n",
    "    fitz = None\n",
    "try:\n",
    "    import ifcopenshell  # IFC file handling\n",
    "except ImportError:\n",
    "    ifcopenshell = None"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def list_repo_files(root: Path) -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    @definition : Return a DataFrame with all files under *root* and their sizes.\n",
    "    @args/params : root – Path to the repository root.\n",
    "    @return : DataFrame with columns ['relative_path', 'size_bytes', 'size_mb'].\n",
    "    \"\"\"\n",
    "    data = []\n",
    "    for dirpath, _, filenames in os.walk(root):\n",
    "        for f in filenames:\n",
    "            p = Path(dirpath) / f\n",
    "            sz = p.stat().st_size\n",
    "            data.append({\n",
    "                'relative_path': str(p.relative_to(root)),\n",
    "                'size_bytes': sz,\n",
    "                'size_mb': sz / (1024 * 1024)\n",
    "            })\n",
    "    return pd.DataFrame(data).sort_values('size_mb', ascending=False).reset_index(drop=True)"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# List repository files (adjust the path if needed)\n",
    "repo_root = Path('')  # Kaggle kernels start in the repo root\n",
    "files_df = list_repo_files(repo_root)\n",
    "display(files_df.head(10))\n",
    "print(f'\nTotal files: {len(files_df)} – Total size: {files_df[\'size_mb\'].sum():.2f} MiB')"
   ],
