{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Exploratory Data Analysis (EDA) – Google Agent Harness Competition\n",
        "\n",
        "Ce notebook charge les données du jeu de développement (29 tâches) et fournit un aperçu rapide :\n",
        "- structure des dossiers,\n- statistique des fichiers (type, taille),\n- aperçu d’un fichier XLSX,\n- métadonnées d’un PDF (nombre de pages, texte bref),\n- lecture d’un fichier IFC4 (nombre d’entités).\n\nLes bibliothèques utilisées sont installées via le **project `uv` environment** (pandas, openpyxl, PyMuPDF, ifcopenshell).\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Imports – PEP8 compliant\n",
        "import json\n",
        "import pathlib\n",
        "import pandas as pd\n",
        "# PDF metadata (requires PyMuPDF)\n        "import fitz  # PyMuPDF\n",
        "# IFC4 parsing (requires ifcopenshell)\n        "try:\n",
        "    import ifcopenshell\n",
        "except ImportError:\n",
        "    ifcopenshell = None  # will skip IFC parsing if not installed\n",
        "\n",
        "# Helper to list files in the repository\n",
        "def list_files(root: pathlib.Path, exts: tuple = ('.pdf', '.xlsx', '.ifc', '.csv', '.txt')) -> pd.DataFrame:\n",
        "    rows = []\n",
        "    for p in root.rglob('*'):\n",
        "        if p.is_file() and p.suffix.lower() in exts:\n",
        "            rows.append({\n",
        "                'path': str(p.relative_to(root)),\n",
        "                'size_kb': p.stat().st_size / 1024,\n",
        "                'ext': p.suffix.lower()\n",
        "            })\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "# Path to the competition data – adjust if your data is in a subfolder\n",
        "DATA_ROOT = pathlib.Path('.')  # repository root\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# List and summarise files\n",
        "df_files = list_files(DATA_ROOT)\n",
        "display(df_files.head())\n",
        "print('Total files:', len(df_files))\n",
        "print('Total size (MiB):', df_files['size_kb'].sum() / 1024)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load a sample XLSX (if any)\n",
        "xlsx_files = df_files[df_files['ext'] == '.xlsx']\n",
        "if not xlsx_files.empty:\n",
        "    sample_path = DATA_ROOT / xlsx_files.iloc[0]['path']\n",
        "    df_xls = pd.read_excel(sample_path)\n",
        "    print('Sample XLSX summary:')\n",
        "    display(df_xls.head())\n",
        "    print('Shape:', df_xls.shape)\n",
        "else:\n",
        "    print('No XLSX files found in the dataset')\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# PDF metadata extraction (first PDF found)\n",
        "pdf_files = df_files[df_files['ext'] == '.pdf']\n",
        "if not pdf_files.empty:\n",
        "    pdf_path = DATA_ROOT / pdf_files.iloc[0]['path']\n",
        "    doc = fitz.open(pdf_path)\n",
        "    print(f'PDF: {pdf_path.name} – pages: {doc.page_count}')\n",
        "    # Extract first page text snippet\n",
        "    page = doc.load_page(0)\n",
        "    text = page.get_text().strip().split('\n')[0]  # first line\n",
        "    print('First line of text:', text[:200])\n",
        "else:\n",
        "    print('No PDF files found')\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# IFC4 inspection (first IFC file) – requires ifcopenshell\n",
        "ifc_files = df_files[df_files['ext'] == '.ifc']\n",
        "if ifcopenshell and not ifc_files.empty:\n",
        "    ifc_path = DATA_ROOT / ifc_files.iloc[0]['path']\n",
        "    model = ifcopenshell.open(str(ifc_path))\n",
        "    entities = model.by_type('IfcProduct')\n",
        "    print(f'IFC: {ifc_path.name} – number of IfcProduct entities:', len(entities))\n",
        "else:\n",
        "    print('IFC parsing skipped (library missing or no IFC files)')\n"
      ]
    }
  ],
  "metadata": {"kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"}, "language_info": {"name": "python", "version": "3.13"}},
